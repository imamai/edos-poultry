NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase 7 — optional. Everything above this line is required; everything
# below degrades gracefully when unset (see README's Phase 7 section).

# Service-role key, used ONLY by src/app/api/mpesa/callback/route.ts to
# update payment status from Safaricom's server-to-server webhook, which
# has no user session to authenticate as. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# M-Pesa (Safaricom Daraja). Unset in this environment — src/lib/payments/mpesa.ts
# returns a typed "not_configured" result rather than faking a payment when
# any of these are missing. See PRODUCT_SPEC.md §44.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_CALLBACK_URL=
MPESA_ENV=sandbox

# AI Assistant free-text mode (spec §54). Unset here — the assistant's
# canned, deterministic questions (src/lib/ai/assistant.ts) work regardless;
# without this key, free-text questions are hidden rather than faked.
ANTHROPIC_API_KEY=
